# Cloud planner (the local PC always connects OUTBOUND)
CLOUD_WS_URL=ws://127.0.0.1:8787
CLOUD_BIND_HOST=0.0.0.0
CLOUD_BIND_PORT=8787

# Shared secret between this PC and the cloud planner
AGENT_TOKEN=change-me-to-a-long-random-secret
AGENT_ID=local-agent-01
PROTOCOL_VERSION=1

# Local dashboard (served by the agent, not exposed to the internet)
UI_HOST=0.0.0.0
UI_PORT=8788

# Minecraft Bedrock target
MC_HOST=127.0.0.1
MC_PORT=19132
MC_USERNAME=AutonomousBuilder
MC_OFFLINE=true
MC_VERSION=
MC_REALM_ID=
MC_REALM_INVITE=
MC_CLIENT=simulated
PROFILES_DIR=./data/profiles
# MC_CLIENT=protocol   # requires optional dep bedrock-protocol + Xbox/offline server

# Safety
ALLOW_NIGHT=false
ALLOW_HOSTILE=false
SAFE_DAY_START=0
SAFE_DAY_END=11000

# Persistence
DATA_DIR=./data
